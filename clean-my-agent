#!/usr/bin/env python3
"""Prefer this checkout's installed UI without installing anything at startup."""
import os
from pathlib import Path
import sys

if __name__ == '__main__':
    env = Path(__file__).resolve().parent / '.venv'
    python = env / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
    if Path(sys.prefix).resolve() != env.resolve() and (env / 'pyvenv.cfg').is_file() and python.is_file():
        os.execv(python, [str(python), __file__, *sys.argv[1:]])

    from clean_my_agent.cli import main
    raise SystemExit(main())
