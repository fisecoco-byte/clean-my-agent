#!/bin/sh
# Run this checkout's built Rust program; never install dependencies at startup.
set -eu
repo=$(CDPATH='' cd -P "$(dirname "$0")" && pwd -P)
if [ -x "$repo/target/release/clean-my-agent" ]; then
    exec "$repo/target/release/clean-my-agent" "$@"
fi
echo '请先运行 cargo build --release --locked，再启动 ./clean-my-agent。' >&2
exit 1
